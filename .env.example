# Firebase Configuration for Province of La Union CSO-Track
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cso-track-la-union.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cso-track-la-union
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cso-track-la-union.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Server-only admin login credentials. Set real values in .env.local or deployment secrets.
CSO_ADMIN_USERNAME=
CSO_ADMIN_PASSWORD=
# Optional dedicated HMAC secret for admin session cookies (recommended in production)
CSO_SESSION_SECRET=

# Cloudinary (file attachments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
